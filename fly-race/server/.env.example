# ---- Fly Race server ----
PORT=4000

# Solana. Devnet only for v1 — the server refuses to boot on mainnet-beta
# unless ALLOW_MAINNET=true is set deliberately.
SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Circle's devnet USDC mint is the default; override only if you know why.
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# DEMO_MODE=true accepts bets without touching the chain and fakes payouts,
# so the whole game loop is testable with no wallet and no funds.
# Set to false to verify real USDC transfers and send real payouts.
DEMO_MODE=true

# Base58 secret key (or a JSON array) for the escrow wallet.
# Required when DEMO_MODE=false. Generate with: node scripts/gen-escrow.js
ESCROW_SECRET_KEY=

# randomWalk (placeholder) or lif (spiking network, placeholder connectome)
BRAIN_KIND=randomWalk

# Where the bet ledger is written.
DATA_FILE=data/flyrace.json

# Test overrides — leave unset in production (defaults: 24h refund, 10s countdown)
# REFUND_TIMEOUT_MS=60000
# COUNTDOWN_MS=3000
